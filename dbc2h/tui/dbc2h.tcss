/* dbc2h theme: classic menuconfig/whiptail look.
 * dbc2h/tui/selftest.py checks some of these values to prove that this file
 * was loaded from the bundle. Update it when changing Screen or #title. */

Screen {
    background: #0000aa;
    color: #ffffff;
    layers: base overlay;
}

#title {
    dock: top;
    height: 1;
    width: 100%;
    background: #aaaaaa;
    color: #000000;
    text-style: bold;
    padding: 0 1;
}

#hint {
    dock: bottom;
    height: 1;
    width: 100%;
    color: #ffff55;
    padding: 0 1;
    margin-bottom: 1;
}

.panel {
    margin: 1 2 1 2;
    height: 1fr;
    background: #aaaaaa;
    color: #000000;
    border: tall #ffffff;
    padding: 0 1;
}

.info {
    height: auto;
    background: #aaaaaa;
    color: #000000;
    margin-bottom: 1;
}

OptionList, DataTable {
    background: #aaaaaa;
    color: #000000;
    border: none;
    height: 1fr;
}

OptionList:focus, DataTable:focus {
    border: none;
    background-tint: transparent;
}

OptionList > .option-list--option-highlighted,
OptionList:focus > .option-list--option-highlighted {
    background: #0000aa;
    color: #ffffff;
    text-style: bold;
}

DataTable > .datatable--header {
    background: #aaaaaa;
    color: #aa0000;
    text-style: bold;
}

DataTable > .datatable--cursor,
DataTable:focus > .datatable--cursor {
    background: #0000aa;
    color: #ffffff;
    text-style: bold;
}

DataTable > .datatable--hover {
    background: #5555ff;
}

/* --- dialogs --------------------------------------------------------------------------- */

ModalScreen {
    align: center middle;
    background: #00000060;
}

.dialog {
    width: 72;
    height: auto;
    max-height: 90%;
    background: #aaaaaa;
    color: #000000;
    border: tall #ffffff;
    padding: 1 2;
}

.dialog-title {
    color: #aa0000;
    text-style: bold;
    margin-bottom: 1;
}

.dialog-text {
    height: auto;
    margin-bottom: 1;
}

.dialog Input {
    background: #ffffff;
    color: #000000;
    border: tall #0000aa;
    margin-bottom: 1;
}

.dialog-buttons {
    height: auto;
    align: center middle;
}

.dialog-buttons Button {
    margin: 0 1;
    min-width: 12;
    background: #aaaaaa;
    color: #000000;
    border: tall #ffffff;
}

.dialog-buttons Button:focus {
    background: #0000aa;
    color: #ffffff;
    text-style: bold;
}

#too-small {
    display: none;
    layer: overlay;
    width: 100%;
    height: 100%;
    content-align: center middle;
    background: #aa0000;
    color: #ffffff;
    text-style: bold;
}

.-too-small #too-small {
    display: block;
}
